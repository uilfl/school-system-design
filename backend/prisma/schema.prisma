// Prisma Schema for School SaaS Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Platform Layer
// ============================================

model Tenant {
  id          String   @id @default(uuid())
  name        String
  subdomain   String   @unique
  logoUrl     String?  @map("logo_url")
  settings    Json     @default("{}")
  status      String   @default("active") // active, suspended, deleted
  planType    String   @default("basic") @map("plan_type") // basic, premium, enterprise
  maxStudents Int      @default(1000) @map("max_students")
  maxTeachers Int      @default(100) @map("max_teachers")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  users       UserTenant[]
  roles       Role[]
  students    Student[]
  teachers    Teacher[]
  parents     Parent[]

  @@index([subdomain])
  @@index([status])
  @@map("tenants")
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  username         String?   @unique
  passwordHash     String?   @map("password_hash")
  phone            String?
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  avatarUrl        String?   @map("avatar_url")
  status           String    @default("active") // active, inactive, locked
  emailVerifiedAt  DateTime? @map("email_verified_at")
  lastLoginAt      DateTime? @map("last_login_at")
  mfaSecret        String?   @map("mfa_secret")
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  oauthProvider    String?   @map("oauth_provider")
  oauthId          String?   @map("oauth_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  // Relations
  tenants    UserTenant[]
  roles      UserRole[]
  student    Student?
  teacher    Teacher?
  parent     Parent?

  @@index([email])
  @@index([username])
  @@map("users")
}

model UserTenant {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([userId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  name        String
  displayName String?  @map("display_name")
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant?    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users  UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model UserRole {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  tenantId   String    @map("tenant_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  assignedBy String?   @map("assigned_by")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

// ============================================
// Student Information System (SIS)
// ============================================

model Student {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  userId          String?   @unique @map("user_id")
  studentNumber   String    @map("student_number")

  // Basic Info
  firstName       String    @map("first_name")
  lastName        String    @map("last_name")
  chineseName     String?   @map("chinese_name")
  gender          String?
  dateOfBirth     DateTime? @map("date_of_birth")
  nationality     String?
  idNumber        String?   @map("id_number")

  // Contact
  email           String?
  phone           String?
  address         String?
  emergencyContact Json?    @map("emergency_contact")

  // Enrollment
  enrollmentDate  DateTime  @map("enrollment_date")
  graduationDate  DateTime? @map("graduation_date")
  status          String    @default("active")

  // Extra
  photoUrl        String?   @map("photo_url")
  metadata        Json      @default("{}")

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  parents      StudentParent[]
  classes      ClassStudent[]
  attendance   AttendanceRecord[]
  grades       GradeRecord[]

  @@unique([tenantId, studentNumber])
  @@index([tenantId, status])
  @@index([userId])
  @@map("students")
}

model Parent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String?  @unique @map("user_id")
  firstName  String   @map("first_name")
  lastName   String   @map("last_name")
  email      String?
  phone      String
  occupation String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  students StudentParent[]

  @@index([tenantId])
  @@map("parents")
}

model StudentParent {
  id                  String   @id @default(uuid())
  studentId           String   @map("student_id")
  parentId            String   @map("parent_id")
  relationship        String?
  isPrimary           Boolean  @default(false) @map("is_primary")
  isEmergencyContact  Boolean  @default(false) @map("is_emergency_contact")
  createdAt           DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parents")
}

model Teacher {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  userId         String?   @unique @map("user_id")
  teacherNumber  String    @map("teacher_number")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String?
  phone          String?
  department     String?
  title          String?
  specialization String[]
  employmentType String?   @map("employment_type")
  hireDate       DateTime? @map("hire_date")
  status         String    @default("active")
  photoUrl       String?   @map("photo_url")
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  courseOfferings CourseOffering[]
  homeroomClasses Class[]

  @@unique([tenantId, teacherNumber])
  @@index([tenantId, status])
  @@map("teachers")
}

// ============================================
// Course & Schedule Management
// ============================================

model AcademicYear {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  name      String
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  isCurrent Boolean   @default(false) @map("is_current")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  semesters Semester[]
  classes   Class[]

  @@unique([tenantId, name])
  @@map("academic_years")
}

model Semester {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  academicYearId String   @map("academic_year_id")
  name           String
  semesterNumber Int      @map("semester_number")
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  isCurrent      Boolean  @default(false) @map("is_current")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  academicYear    AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  courseOfferings CourseOffering[]

  @@map("semesters")
}

model Grade {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  name         String
  gradeLevel   Int      @map("grade_level")
  displayOrder Int?     @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  classes Class[]

  @@unique([tenantId, gradeLevel])
  @@map("grades")
}

model Class {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  gradeId          String   @map("grade_id")
  academicYearId   String?  @map("academic_year_id")
  name             String
  classNumber      String?  @map("class_number")
  homeroomTeacherId String? @map("homeroom_teacher_id")
  maxStudents      Int      @default(40) @map("max_students")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  grade           Grade          @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear?  @relation(fields: [academicYearId], references: [id])
  homeroomTeacher Teacher?       @relation(fields: [homeroomTeacherId], references: [id])
  students        ClassStudent[]

  @@index([tenantId])
  @@index([gradeId])
  @@map("classes")
}

model ClassStudent {
  id         String    @id @default(uuid())
  classId    String    @map("class_id")
  studentId  String    @map("student_id")
  semesterId String?   @map("semester_id")
  seatNumber Int?      @map("seat_number")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  leftAt     DateTime? @map("left_at")

  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId, semesterId])
  @@map("class_students")
}

model Course {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  courseCode  String   @map("course_code")
  courseName  String   @map("course_name")
  description String?
  credits     Decimal  @db.Decimal(3, 1)
  courseType  String?  @map("course_type")
  department  String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  offerings CourseOffering[]

  @@unique([tenantId, courseCode])
  @@map("courses")
}

model CourseOffering {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  courseId          String   @map("course_id")
  semesterId        String   @map("semester_id")
  teacherId         String?  @map("teacher_id")
  section           String?
  maxEnrollment     Int      @default(50) @map("max_enrollment")
  currentEnrollment Int      @default(0) @map("current_enrollment")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  course     Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester   Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  teacher    Teacher?           @relation(fields: [teacherId], references: [id])
  schedules  Schedule[]
  attendance AttendanceRecord[]
  grades     GradeRecord[]

  @@map("course_offerings")
}

model Schedule {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  courseOfferingId String   @map("course_offering_id")
  dayOfWeek        Int      @map("day_of_week")
  periodNumber     Int      @map("period_number")
  startTime        DateTime @map("start_time") @db.Time
  endTime          DateTime @map("end_time") @db.Time
  classroom        String?
  createdAt        DateTime @default(now()) @map("created_at")

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@index([courseOfferingId])
  @@map("schedules")
}

// ============================================
// Attendance Management
// ============================================

model AttendanceRecord {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  studentId        String   @map("student_id")
  courseOfferingId String?  @map("course_offering_id")
  attendanceDate   DateTime @map("attendance_date") @db.Date
  periodNumber     Int?     @map("period_number")
  status           String   // present, absent, late, excused, sick
  notes            String?
  recordedBy       String?  @map("recorded_by")
  recordedAt       DateTime @default(now()) @map("recorded_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  student        Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering? @relation(fields: [courseOfferingId], references: [id])

  @@index([studentId, attendanceDate])
  @@index([courseOfferingId, attendanceDate])
  @@map("attendance_records")
}

// ============================================
// Grade Management
// ============================================

model GradeRecord {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  studentId        String    @map("student_id")
  courseOfferingId String    @map("course_offering_id")
  assessmentType   String?   @map("assessment_type")
  assessmentName   String?   @map("assessment_name")
  score            Decimal?  @db.Decimal(5, 2)
  maxScore         Decimal   @default(100) @map("max_score") @db.Decimal(5, 2)
  percentage       Decimal?  @db.Decimal(5, 2)
  gradeLetter      String?   @map("grade_letter")
  passed           Boolean?
  notes            String?
  gradedBy         String?   @map("graded_by")
  gradedAt         DateTime? @map("graded_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([courseOfferingId])
  @@map("grade_records")
}
